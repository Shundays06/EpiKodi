# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/epikodi"

# Redis Cache (Optional - Recommended for production)
# Uncomment to enable caching for TMDB API requests
# REDIS_URL="redis://localhost:6379"

# TheMovieDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your_tmdb_api_key_here"
TMDB_BASE_URL="https://api.themoviedb.org/3"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Media Storage Configuration
# Path to your local media files (absolute path)
MEDIA_PATH="/path/to/your/media/folder"

# Upload path for user-uploaded content
UPLOAD_PATH="./uploads"

# Application Configuration
NODE_ENV="development"
PORT=3000
