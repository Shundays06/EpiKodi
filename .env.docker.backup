# ⚠️ Configuration Docker pour EpiKodi
# Copiez ce fichier en .env avant de lancer docker-compose

# TheMovieDB API
# Obtenez votre clé sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=a683fb7fe3e97f401b4b60df6763ceb5

# NextAuth Secret
# Générez avec: openssl rand -base64 32
NEXTAUTH_SECRET=votre-secret-super-securise-a-changer

# Les autres variables sont déjà configurées dans docker-compose.yml
